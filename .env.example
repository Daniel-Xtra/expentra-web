# All VITE_* variables are embedded in the client bundle at build time.
# They are publicly visible — never put secrets here.

# API base URL (use /api/v1 with Vite dev proxy, or full URL in production)
VITE_API_URL=/api/v1

# Application environment label (development | production)
VITE_APP_ENV=development

# Optional: backend origin for dev proxy when VITE_API_URL is relative
# VITE_API_PROXY_TARGET=http://localhost:3000
